{
  "name": "ballpark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bundle-content": "tsx tools/bundleContent.ts",
    "build": "npm run bundle-content && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts",
    "typecheck:worker": "npm run bundle-content && tsc -p worker/tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "worker:dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
